# ---------------------------------------------
# Unreal Engine project .gitattributes
# ---------------------------------------------

# Default: let git decide, normalize text line endings in the repo
* text=auto

# --- Source / text files: explicit text, LF in repo ---
*.cpp               text eol=lf diff=cpp
*.h                 text eol=lf diff=cpp
*.hpp               text eol=lf diff=cpp
*.c                 text eol=lf
*.inl               text eol=lf
*.cs                text eol=lf diff=csharp
*.usf               text eol=lf
*.ush               text eol=lf
*.cginc             text eol=lf
*.hlsl              text eol=lf
*.py                text eol=lf diff=python
*.sh                text eol=lf
*.bat               text eol=crlf
*.cmd               text eol=crlf
*.ps1               text eol=crlf
*.md                text eol=lf
*.txt               text eol=lf
*.json              text eol=lf
*.xml               text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.ini               text eol=lf
*.cfg               text eol=lf
*.uproject          text eol=lf
*.uplugin           text eol=lf
*.Target.cs         text eol=lf
*.Build.cs          text eol=lf
*.gitattributes     text eol=lf
*.gitignore         text eol=lf

# --- Unreal binary assets: Git LFS, never merged, never diffed ---
*.uasset            filter=lfs diff=lfs merge=lfs -text
*.umap              filter=lfs diff=lfs merge=lfs -text
*.upack             filter=lfs diff=lfs merge=lfs -text
*.udk               filter=lfs diff=lfs merge=lfs -text
*.ubulk             filter=lfs diff=lfs merge=lfs -text
*.uexp              filter=lfs diff=lfs merge=lfs -text
*.uplugin.bak       filter=lfs diff=lfs merge=lfs -text
*.ddc               filter=lfs diff=lfs merge=lfs -text

